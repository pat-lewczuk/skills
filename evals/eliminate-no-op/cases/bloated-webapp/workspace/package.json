{
  "name": "storefront",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev --port 4310",
    "build": "next build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "db:migrate": "node migrations/run.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
